          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "id": "26fc4bae-f435-40b6-8a87-aa4a45461782",
      "name": "Save Lead to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        224,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Lead name: {{ ($(\"Contact Form Webhook\").item.json.body.name || $(\"Contact Form Webhook\").item.json.body.Name) }}\nLead message: {{ ($(\"Contact Form Webhook\").item.json.body.message || $(\"Contact Form Webhook\").item.json.body.Message) }}",
        "messages": {
          "messageValues": [
            {
              "message": "You write short, warm, professional follow-up emails for a small business. Reply with the email body only, plain text, 80-120 words, no subject line. Acknowledge the specific points in the lead message, say we will reply in detail within one business day, and sign off as \"The Team\"."
            }
          ]
        },
        "batching": {}
      },
      "id": "5045be5d-7343-4b8f-9b2d-bac796e1d8b8",
      "name": "Write Follow-up Email",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "model": "nvidia/nemotron-3.5-lightning:free",
        "options": {
          "reasoningEffort": "minimal",
          "maxTokens": 3000
        }
      },
      "id": "d4fd29d0-8882-4b64-9e73-254bdf9b5188",
      "name": "OpenRouter Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        448,
        240
      ],
      "credentials": {
        "openRouterApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ ($(\"Contact Form Webhook\").item.json.body.email || $(\"Contact Form Webhook\").item.json.body.Email) }}",
        "subject": "=Thanks for contacting us, {{ ($(\"Contact Form Webhook\").item.json.body.name || $(\"Contact Form Webhook\").item.json.body.Name) }}",
        "emailType": "text",
        "message": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "e94b5e5f-c1b6-4f43-a9f8-bd419a22a769",
      "name": "Send Follow-up Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
