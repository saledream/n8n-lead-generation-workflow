        0
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=New lead\nName: {{ ($(\"Contact Form Webhook\").item.json.body.name || $(\"Contact Form Webhook\").item.json.body.Name) }}\nEmail: {{ ($(\"Contact Form Webhook\").item.json.body.email || $(\"Contact Form Webhook\").item.json.body.Email) }}\nMessage: {{ ($(\"Contact Form Webhook\").item.json.body.message || $(\"Contact Form Webhook\").item.json.body.Message) }}\n\nFollow-up email sent.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "d3f0d5d2-105b-43fa-968e-2e893360aec0",
      "name": "Notify on Telegram",
      "type": "n8n-nodes-base.telegram",
